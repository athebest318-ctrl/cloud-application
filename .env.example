APP_NAME=Cloud Application
APP_VERSION=1.0
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8010
API_PREFIX=/api
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cloud_application
DB_USER=cloud_app
# Secrets: secrets/lab_db_password and secrets/auth_secret
HTTPS_ENABLED=false
HTTPS_PORT=8443
SSL_CERTFILE=certs/localhost.pem
SSL_KEYFILE=certs/localhost-key.pem
NOTIFICATION_SERVICE_URL=http://127.0.0.1:9000
NOTIFICATION_TIMEOUT_SECONDS=2.0
NOTIFICATION_MAX_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_SECONDS=0.5
STORAGE_PATH=storage/objects
MAX_UPLOAD_SIZE=5242880

LOG_LEVEL=INFO
